# ── EDUVERSE Learning Platform — Environment Variables ──────────────
# Copy to .env.local and fill in your values.

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:4006
NEXT_PUBLIC_APP_NAME=EDUVERSE
NEXT_PUBLIC_APP_DESCRIPTION=Modern learning infrastructure for the next generation
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ── API ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api
API_SECRET_KEY=

# ── Authentication ──────────────────────────────────────────────────
AUTH_SECRET=
AUTH_URL=http://localhost:4006

# OAuth Providers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ID=
AUTH_MICROSOFT_SECRET=

# ── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eduverse
DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/eduverse

# ── Supabase (Auth + Storage + Realtime) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Storage ─────────────────────────────────────────────────────────
STORAGE_BUCKET=eduverse-assets
NEXT_PUBLIC_STORAGE_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# ── Live Classes (Streaming / WebRTC) ──────────────────────────────
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_DAILY_API_KEY=
DAILY_API_SECRET=

# ── AI / ML Services ────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NEXT_PUBLIC_AI_ENABLED=false

# ── Email ───────────────────────────────────────────────────────────
EMAIL_FROM=noreply@eduverse.com
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Payment / Subscriptions ─────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# ── Search ──────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=
NEXT_PUBLIC_MEILISEARCH_ENABLED=false

# ── Observability ───────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_VERCEL_ANALYTICS=true
NEXT_PUBLIC_VERCEL_DEBUG=false

# ── Rate Limiting ───────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ── Feature Flags ───────────────────────────────────────────────────
NEXT_PUBLIC_FEATURE_LIVE_CLASSES=true
NEXT_PUBLIC_FEATURE_AI_TUTOR=true
NEXT_PUBLIC_FEATURE_CERTIFICATES=true
NEXT_PUBLIC_FEATURE_GAMIFICATION=true
NEXT_PUBLIC_FEATURE_ANALYTICS=true

# ── Build ───────────────────────────────────────────────────────────
NEXT_OUTPUT=standalone
NEXT_TELEMETRY_DISABLED=1

# ── CDN ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CDN_URL=
